    agent any

    stages {
        stage('Compile') {
            steps {
                bat 'javac helloworld.java'
            }
        }

        stage('Run') {
            steps {
                bat 'java helloworld'
            }
        }git branch: 'main', credentialsId: '72fe60cb-9c7f-47fc-9c6e-a850cf61ffb7', url: 'https://github.com/tanmayjoshi01/JAVAPipeline.git'
    }
}
